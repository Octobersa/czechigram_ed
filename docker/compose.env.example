# Copy this file to .env.docker and replace all CHANGE_ME values before running docker compose.
# Never commit real credentials or tokens.

# MySQL
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_MYSQL_PASSWORD
DATABASE_URL=mysql://root:CHANGE_ME_STRONG_MYSQL_PASSWORD@mysql:3306
SHADOW_DATABASE_URL=mysql://root:CHANGE_ME_STRONG_MYSQL_PASSWORD@mysql:3306/shadow_db

# App auth
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
API_STUDENT_MANAGEMENT_TOKEN=CHANGE_ME_LONG_RANDOM_MANAGEMENT_TOKEN

# MinIO
MINIO_API_URL=http://minio:9000
MINIO_BUCKET_NAME=uploads
MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_ROOT_PASSWORD
MINIO_ACCESS_KEY_ID=CHANGE_ME_MINIO_ACCESS_KEY_ID
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY

# Optional Prisma lifecycle tuning
STUDENT_PRISMA_CACHE_MAX=20
STUDENT_PRISMA_IDLE_MS=600000
STUDENT_PRISMA_SWEEP_INTERVAL_MS=60000
STUDENT_PRISMA_CONNECTION_LIMIT=1
STUDENT_PRISMA_SCHEMA_CHECK_INTERVAL_MS=0
